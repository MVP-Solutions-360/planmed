# Autenticación contra Wellezy Hub (solo servidor; NO usar NUXT_PUBLIC_*).
# Producción: https://wellezyhub.com/api  |  Local: http://localhost:8000/api
NUXT_WELLEZY_API_BASE_URL=
NUXT_WELLEZY_COMPANY_SLUG=planmed
NUXT_WELLEZY_LINE_SLUG=planmed
# IDs de rol de Wellezy autorizados para el CMS, separados por coma.
NUXT_PLANMED_ADMIN_ROLE_IDS=19
# Opcional: ids de rol que pueden ESCRIBIR el contenido local (Nosotros, Clinicas, paginas), ademas de los perfiles reconocidos por nombre.
NUXT_PLANMED_CONTENT_EDITOR_ROLE_IDS=

# REQUERIDO. Secreto de la cookie de sesión: mínimo 32 caracteres aleatorios. No lo subas al repositorio.
NUXT_SESSION_PASSWORD=

# Contenido administrado localmente en la web (pagina Nosotros). Directorio PERSISTENTE fuera de .output/ (vacio = ./.data/planmed-content).
NUXT_PLANMED_CONTENT_DIR=

# Proxies de confianza delante de la aplicacion (0 = ignorar X-Forwarded-For). Subir a 1 solo tras confirmar que hay UN proxy (p. ej. Nginx Proxy Manager)
# que anade la IP real al final de X-Forwarded-For y que Node no es alcanzable sin pasar por el.
NUXT_TRUSTED_PROXY_HOPS=0

# ── NECESARIAS PARA EL FORMULARIO «ESTUDIO DE CRÉDITOS» (envío por correo SMTP) ──────────────────────────────────────────────────────────
# Las define el administrador en el servidor; NUNCA se suben al repositorio ni se escriben en este archivo de ejemplo. Sin ellas el formulario
# responde 503 y no envía nada. Conexión cifrada obligatoria: puerto 465 (TLS) o 587 (STARTTLS). SOLO servidor (no usar NUXT_PUBLIC_*).
NUXT_MAIL_HOST=
NUXT_MAIL_PORT=
NUXT_MAIL_USERNAME=
NUXT_MAIL_PASSWORD=
# Remitente. Si queda vacío se usa NUXT_MAIL_USERNAME cuando es un correo. Con muchos proveedores debe coincidir con la cuenta autenticada.
NUXT_MAIL_FROM_ADDRESS=
NUXT_MAIL_FROM_NAME=Planmed
# Destinatarios del estudio de crédito. PENDIENTES: el negocio debe indicar los autorizados de Planmed; NO hay valor por defecto y no se reutilizan los de
# otra marca. Mientras NUXT_CREDIT_STUDY_TO esté vacío el envío permanece bloqueado. Varias direcciones separadas por coma. NUXT_CREDIT_STUDY_CC es opcional.
NUXT_CREDIT_STUDY_TO=
NUXT_CREDIT_STUDY_CC=
# Solicitud de financiación (LeadForm): PENDIENTES, mismos criterios (sin valor por defecto; bloqueado mientras NUXT_LEAD_FORM_TO esté vacío).
NUXT_LEAD_FORM_TO=
NUXT_LEAD_FORM_CC=
# Notificación complementaria de valoración (tras confirmar el CRM) y de referidos (tras confirmar Hub): PENDIENTES. Vacío = no se envía correo; CRM/Hub no dependen de él.
NUXT_VALUATION_TO=
NUXT_VALUATION_CC=
NUXT_REFERRAL_TO=
NUXT_REFERRAL_CC=
# Formulario de valoración → paciente en el CRM Médico. SOLO servidor. Sin NUXT_CRM_FORM_URL no se envía nada y el formulario responde 503.
# Debe terminar en /api/clients/forms. Producción: https://pdtclientsolutions.com/crm-public/api/clients/forms (NO usarla en local ni en pruebas: crea pacientes reales).
NUXT_CRM_FORM_URL=
# Opcionales: sin ellos se usan los del formulario público de Planmed (usuario 73, línea 16, asesora 73). No dejarlos definidos y vacíos.
# NUXT_CRM_FORM_USER_ID=
# NUXT_CRM_FORM_LINE_ID=
# NUXT_CRM_FORM_ADVISOR_ID=
