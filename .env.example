# Autenticación contra Wellezy Hub (solo servidor; NO usar NUXT_PUBLIC_*).
# Producción: https://wellezyhub.com/api  |  Local: http://localhost:8000/api
NUXT_WELLEZY_API_BASE_URL=
NUXT_WELLEZY_COMPANY_SLUG=planmed
NUXT_WELLEZY_LINE_SLUG=planmed
# IDs de rol de Wellezy autorizados para el CMS, separados por coma.
NUXT_PLANMED_ADMIN_ROLE_IDS=19

# REQUERIDO. Secreto de la cookie de sesión: mínimo 32 caracteres aleatorios. No lo subas al repositorio.
NUXT_SESSION_PASSWORD=

# Contenido administrado localmente en la web (pagina Nosotros). Directorio PERSISTENTE fuera de .output/ (vacio = ./.data/planmed-content).
NUXT_PLANMED_CONTENT_DIR=

# Proxies de confianza delante de la aplicacion (0 = ignorar X-Forwarded-For). Subir a 1 solo tras confirmar que hay UN proxy (p. ej. Nginx Proxy Manager)
# que anade la IP real al final de X-Forwarded-For y que Node no es alcanzable sin pasar por el.
NUXT_TRUSTED_PROXY_HOPS=0
