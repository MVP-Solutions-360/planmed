# Autenticación contra Wellezy Hub (solo servidor; NO usar NUXT_PUBLIC_*).
# Producción: https://wellezyhub.com/api  |  Local: http://localhost:8000/api
NUXT_WELLEZY_API_BASE_URL=
NUXT_WELLEZY_COMPANY_SLUG=planmed
NUXT_WELLEZY_LINE_SLUG=planmed
# IDs de rol de Wellezy autorizados para el CMS, separados por coma.
NUXT_PLANMED_ADMIN_ROLE_IDS=19

# REQUERIDO. Secreto de la cookie de sesión: mínimo 32 caracteres aleatorios. No lo subas al repositorio.
NUXT_SESSION_PASSWORD=
